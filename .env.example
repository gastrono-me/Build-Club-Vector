# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Google OAuth client ID — create at console.cloud.google.com (APIs & Services > Credentials)
# Add http://localhost:5173 and your *.vercel.app domain as Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=...apps.googleusercontent.com

# Vercel KV — attach a KV store to the project (Storage > Create > KV) and these are auto-populated
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Ably — create a free app at ably.com and copy the Root API key (Dashboard > API Keys)
ABLY_API_KEY=
